{
  "id": "/dashboard",
  "name": "Synergy Swift",
  "short_name": "Synergy Swift",
  "description": "School management, results, fees, attendance and parent updates in one app.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f8fafc",
