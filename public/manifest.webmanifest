  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My children", "short_name": "Children", "url": "/parent", "description": "Your children's day, results, fees and bus" },
    { "name": "My teaching day", "short_name": "Teaching", "url": "/teacher", "description": "Today's lessons, registers and to-do list" },
    { "name": "Class register", "short_name": "Register", "url": "/school/attendance", "description": "Take the register, even offline" },
    { "name": "My school", "short_name": "My day", "url": "/student", "description": "Today's lessons, homework and results" }
  ]
}
