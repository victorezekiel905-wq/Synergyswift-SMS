# =========================================================================
# EduClass Fusion — environment template
# Copy to .env.local and fill in the values from your Supabase project.
# NEVER commit .env.local.
# =========================================================================

# Browser-safe (must be NEXT_PUBLIC_*). Your Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Browser-safe. The "anon" JWT (role: anon). All client access runs under RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-jwt...

# Server-only admin key. NEVER expose to the browser — use the RLS-bound server
# client (`@/lib/supabase/server`) for app code; reserve this for trusted server
# tasks such as backfills and migrations if you run `supabase db push` locally.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-jwt...

# Optional: background worker secret used by `/api/devices/*` if you put it
# behind a reverse proxy / VPN. Leave empty for localhost development.
DEVICE_INGEST_TOKEN=

# Optional: origin allow-list for cross-site API requests (comma-separated).
# Defaults to NEXT_PUBLIC_SUPABASE_URL's origin + http://localhost:3000.
ALLOWED_ORIGINS=http://localhost:3000

# Optional production billing. Map each seeded plan name to its Stripe Price ID.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRICE_TEACHER_PRO=price_replace_me
STRIPE_PRICE_SCHOOL=price_replace_me
STRIPE_PRICE_SCHOOL_PLUS=price_replace_me
STRIPE_PRICE_ENTERPRISE_DISTRICT=price_replace_me
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =========================================================================
# School operations (v45): results delivery, gate alerts, pickup codes
# =========================================================================
# Public base URL used in links sent to parents (report cards, portal links).
# NEXT_PUBLIC_APP_URL above must be your real https domain in production.

# Schools are created by the platform admin. Set to true only if you want
# anyone who signs up to get their own school automatically.
ALLOW_SELF_SERVE_TENANTS=false

# Protects /api/cron/dispatch (every minute) and /api/cron/daily (once a day).
# Call them with header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Country code added to local phone numbers such as 08031234567 (234 = Nigeria).
DEFAULT_COUNTRY_CODE=234

# ---- Email: resend (default) or sendgrid ----
EMAIL_PROVIDER=resend
EMAIL_FROM=results@your-domain.com
RESEND_API_KEY=
SENDGRID_API_KEY=

# ---- WhatsApp: meta (WhatsApp Cloud API, default) or twilio ----
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_LANG=en
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Approved WhatsApp template names (Meta) or Content SIDs (Twilio).
# Without a template, WhatsApp only delivers to parents who messaged you in
# the last 24 hours. Body texts to register are in docs/MESSAGING.md.
WHATSAPP_TPL_RESULT=
WHATSAPP_TPL_GATE=
WHATSAPP_TPL_PICKUP_CODE=
WHATSAPP_TPL_PICKUP_DONE=
WHATSAPP_TPL_BROADCAST=
WHATSAPP_TPL_PORTAL=
WHATSAPP_TPL_LIBRARY=

# =========================================================================
# v46: payments, SMS, AI
# =========================================================================
# ---- Online fee payments (the platform holds the account; each school sets
#      its settlement subaccount code in Fees -> Online payments) ----
PAYSTACK_SECRET_KEY=
FLW_SECRET_KEY=
# Flutterwave webhook "secret hash" (Dashboard -> Settings -> Webhooks)
FLW_SECRET_HASH=
# Used as the payer email when a parent has none on file (providers require one)
PAYMENTS_FALLBACK_EMAIL=
# Webhook URLs to set in the provider dashboards:
#   https://your-domain.com/api/pay/webhook/paystack
#   https://your-domain.com/api/pay/webhook/flutterwave

# ---- SMS fallback for parents without WhatsApp: termii | twilio | africastalking ----
SMS_PROVIDER=
SMS_SENDER_ID=
TERMII_API_KEY=
TERMII_CHANNEL=dnd
TWILIO_SMS_FROM=
AT_USERNAME=
AT_API_KEY=

# ---- AI lesson notes and report comments (Claude) ----
ANTHROPIC_API_KEY=

# ---- More WhatsApp templates (bodies in docs/MESSAGING.md) ----
WHATSAPP_TPL_ABSENCE=
WHATSAPP_TPL_FEE_RECEIPT=
WHATSAPP_TPL_FEE_REMINDER=
WHATSAPP_TPL_BEHAVIOUR=
WHATSAPP_TPL_HEALTH=
WHATSAPP_TPL_BUS=
WHATSAPP_TPL_EXEAT=
WHATSAPP_TPL_EVENT=
WHATSAPP_TPL_MEETING=
WHATSAPP_TPL_ADMISSION=
WHATSAPP_TPL_STAFF=
