# =========================================================================
# EduClass Fusion — environment template
# Copy to .env.local and fill in the values from your Supabase project.
# NEVER commit .env.local.
# =========================================================================

# Browser-safe (must be NEXT_PUBLIC_*). Your Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Browser-safe. The "anon" JWT (role: anon). All client access runs under RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-jwt...

# Server-only admin key. NEVER expose to the browser — use the RLS-bound server
# client (`@/lib/supabase/server`) for app code; reserve this for trusted server
# tasks such as backfills and migrations if you run `supabase db push` locally.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-jwt...

# Optional: background worker secret used by `/api/devices/*` if you put it
# behind a reverse proxy / VPN. Leave empty for localhost development.
DEVICE_INGEST_TOKEN=

# Optional: origin allow-list for cross-site API requests (comma-separated).
# Defaults to NEXT_PUBLIC_SUPABASE_URL's origin + http://localhost:3000.
ALLOWED_ORIGINS=http://localhost:3000

# Optional production billing. Map each seeded plan name to its Stripe Price ID.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRICE_TEACHER_PRO=price_replace_me
STRIPE_PRICE_SCHOOL=price_replace_me
STRIPE_PRICE_SCHOOL_PLUS=price_replace_me
STRIPE_PRICE_ENTERPRISE_DISTRICT=price_replace_me
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =========================================================================
# School operations (v45): results delivery, gate alerts, pickup codes
# =========================================================================
# Public base URL used in links sent to parents (report cards, portal links).
# NEXT_PUBLIC_APP_URL above must be your real https domain in production.

# Schools are created only by the platform owner, or by a prospect with a one-time school code
# made in the platform console (Platform → School codes). There is no open self-signup.

# Protects /api/cron/dispatch (every minute) and /api/cron/daily (once a day).
# Call them with header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Country code added to local phone numbers such as 08031234567 (234 = Nigeria).
DEFAULT_COUNTRY_CODE=234

# ---- Email: resend (default) or sendgrid ----
# Also sends every sign-in email (confirm a new account, reset a password, platform team invitations), so
# Supabase sends none of them. With SendGrid, EMAIL_FROM must be a verified sender or domain in SendGrid.
# Without an email service, new accounts wait on the admins' Sign-ups page to be confirmed.
EMAIL_PROVIDER=resend
EMAIL_FROM=results@your-domain.com
RESEND_API_KEY=
SENDGRID_API_KEY=

# ---- WhatsApp: meta (WhatsApp Cloud API, default) or twilio ----
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_LANG=en
# Two-way inbox: parents' replies arrive at /api/whatsapp/webhook. Meta: subscribe with this verify
# token; requests are checked with the app secret (Twilio requests are checked with TWILIO_AUTH_TOKEN).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Approved WhatsApp template names (Meta) or Content SIDs (Twilio).
# Without a template, WhatsApp only delivers to parents who messaged you in
# the last 24 hours. Body texts to register are in docs/MESSAGING.md.
WHATSAPP_TPL_RESULT=
WHATSAPP_TPL_GATE=
WHATSAPP_TPL_PICKUP_CODE=
WHATSAPP_TPL_PICKUP_DONE=
WHATSAPP_TPL_BROADCAST=
WHATSAPP_TPL_PORTAL=
WHATSAPP_TPL_LIBRARY=

# =========================================================================
# v46: payments, SMS, drafting and translation
# =========================================================================
# ---- Online fee payments (the platform holds the account; each school sets
#      its settlement subaccount code in Fees -> Online payments) ----
# Synergy Swift's own Paystack account. School fees settle to each school's subaccount; schools paying their
# Synergy Swift invoice (/billing/<link>, Pay now) settle to this main account.
PAYSTACK_SECRET_KEY=
# Optional: signs the private invoice pay links (defaults to a key made from the service role key).
BILLING_LINK_KEY=
FLW_SECRET_KEY=
# Flutterwave webhook "secret hash" (Dashboard -> Settings -> Webhooks)
FLW_SECRET_HASH=
# Used as the payer email when a parent has none on file (providers require one)
PAYMENTS_FALLBACK_EMAIL=
# Webhook URLs to set in the provider dashboards:
#   https://your-domain.com/api/pay/webhook/paystack
#   https://your-domain.com/api/pay/webhook/flutterwave

# ---- SMS fallback for parents without WhatsApp: termii | twilio | africastalking ----
SMS_PROVIDER=
SMS_SENDER_ID=
TERMII_API_KEY=
TERMII_CHANNEL=dnd
TWILIO_SMS_FROM=
AT_USERNAME=
AT_API_KEY=

# ---- AI (phase 14p), on Google Gemini: report comments, lesson notes, notices, translation for parents,
#      homework feedback, quiz questions, slides, the study helper, the AI sales manager and admissions office.
#      Get a key at https://aistudio.google.com (a Vertex AI express key also works). ----
GEMINI_API_KEY=
# Optional: the model for everyday jobs, and a stronger one for slides, quizzes and lesson notes.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_PRO=
# Extra text AI services (any OpenAI-compatible API), tried after Gemini when it is busy or out of free quota.
# Groq and OpenRouter need only their key (model optional: Groq openai/gpt-oss-120b, OpenRouter openrouter/free):
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Any other service, up to six: AI_EXTRA_<n>_NAME, _URL (the API base), _KEY, _MODEL, optional _MODEL_PRO. For example:
#   Groq:        https://api.groq.com/openai/v1           model e.g. openai/gpt-oss-120b
#   OpenRouter:  https://openrouter.ai/api/v1             model ending in :free
#   Mistral:     https://api.mistral.ai/v1                model e.g. mistral-small-latest
#   Cerebras:    https://api.cerebras.ai/v1
#   GitHub:      https://models.github.ai/inference
AI_EXTRA_1_NAME=
AI_EXTRA_1_URL=
AI_EXTRA_1_KEY=
AI_EXTRA_1_MODEL=
AI_EXTRA_2_NAME=
AI_EXTRA_2_URL=
AI_EXTRA_2_KEY=
AI_EXTRA_2_MODEL=
AI_EXTRA_3_NAME=
AI_EXTRA_3_URL=
AI_EXTRA_3_KEY=
AI_EXTRA_3_MODEL=
# 1 = spread requests across all the providers instead of always starting with Gemini.
AI_ROTATE=0
# Requests per school per month unless the school has its own limit (default 3000).
AI_MONTHLY_LIMIT=3000
# Photos for AI-made slides: Pixabay first (https://pixabay.com/api/docs/, free key), Unsplash as a fallback. Optional.
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
# "Open in Canva" for slides: a Canva Connect integration (https://www.canva.dev → Your integrations) with the scopes
# design:content:write and design:meta:read, and the redirect URL <NEXT_PUBLIC_APP_URL>/api/canva/callback.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Only used when GEMINI_API_KEY is empty (older servers).
ANTHROPIC_API_KEY=

# ---- Zoom for online lessons (optional). A Server-to-Server OAuth app. Each school can also connect its own
#      Zoom account under Learning library → Online lessons; without either, teachers paste meeting links. ----
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ---- More payment options (optional; each school can also enter its own under Fees → Online payments) ----
# Remita: merchant ID, service type ID and API key; REMITA_LIVE=1 for live (otherwise the demo system)
REMITA_MERCHANT_ID=
REMITA_SERVICE_TYPE_ID=
REMITA_API_KEY=
REMITA_LIVE=
# Stripe, for cards from abroad, and its webhook signing secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- More WhatsApp templates (bodies in docs/MESSAGING.md) ----
WHATSAPP_TPL_ABSENCE=
WHATSAPP_TPL_FEE_RECEIPT=
WHATSAPP_TPL_FEE_REMINDER=
WHATSAPP_TPL_BEHAVIOUR=
WHATSAPP_TPL_HEALTH=
WHATSAPP_TPL_BUS=
WHATSAPP_TPL_EXEAT=
WHATSAPP_TPL_EVENT=
WHATSAPP_TPL_MEETING=
WHATSAPP_TPL_ADMISSION=
WHATSAPP_TPL_ADMISSION_NOTE=
WHATSAPP_TPL_COMMUNITY_NOTE=
WHATSAPP_TPL_STAFF=
WHATSAPP_TPL_MESSAGE=
WHATSAPP_TPL_WALLET=
WHATSAPP_TPL_WALLET_LOW=
WHATSAPP_TPL_BUS_NEAR=

# =========================================================================
# v47: app push notifications (free per message)
# Generate once with:  npx web-push generate-vapid-keys
# =========================================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push services can reach, e.g. mailto:ops@your-company.com
VAPID_SUBJECT=

# Native Android / iPhone app notifications (Firebase Cloud Messaging).
# From a Firebase service account: Project settings -> Service accounts -> Generate new private key.
# Paste the private key on one line with \n for line breaks. See docs/MOBILE_APPS.md.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Google Classroom (a Google Cloud OAuth client, web application, with the Classroom API turned on).
# Authorised redirect URI: <NEXT_PUBLIC_APP_URL>/api/connect/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Teams and OneNote (an Entra ID app registration, web platform).
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/connect/microsoft/callback ; MICROSOFT_TENANT = your tenant id, or "common" for many schools
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# =========================================================================
# Exams: network restriction reads the client IP from X-Forwarded-For.
# Number of proxies in front of the app: Render alone = 1 (default);
# Cloudflare in front of Render = 2. A wrong value lets students fake their IP.
# =========================================================================
TRUSTED_PROXY_HOPS=1

# Single sign-on buttons on the login page: the providers switched on in Supabase Auth (google, azure).
NEXT_PUBLIC_SSO_PROVIDERS=

# Report-card signatures (QR verification). Optional: without it a key is
# derived from SUPABASE_SERVICE_ROLE_KEY. Changing it marks earlier cards as
# unverifiable until they are re-published or recomputed.
REPORT_SIGNING_KEY=
# Launch links for learning content (SCORM, xAPI, H5P). Optional: derived from
# SUPABASE_SERVICE_ROLE_KEY when unset. Changing it closes content already open.
CONTENT_SIGNING_KEY=

# Automatic marking of code answers. JavaScript runs in a built-in sandbox.
# For Python, Java, C, C++, C# and SQL, point to a Judge0 server: self-hosted
# (https://github.com/judge0/judge0) or RapidAPI (JUDGE0_URL=https://judge0-ce.p.rapidapi.com).
# Student code is sent to that server. Without it those answers are teacher-marked.
JUDGE0_URL=
JUDGE0_KEY=
